{
  "name": "skipbo",
  "version": "1.0.1",
  "description": "Skip-Bo card game for Mac and Windows",
  "main": "./out/main/index.js",
  "author": "Steve",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:sim": "vitest run tests/sim",
    "test:e2e": "npm run build && playwright test",
    "dist:mac": "npm run build && electron-builder --mac --universal --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@playwright/test": "1.64",
    "@types/node": "^26.6.6",
    "electron": "^45.2.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "gsap": "3.15"
  }
}
